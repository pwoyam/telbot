# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated) - these users have NO rate limit
ADMIN_USER_IDS=123456789

# AI Provider: openai or anthropic
AI_PROVIDER=openai

# AI API Key
AI_API_KEY=your_api_key_here

# Optional: Custom base URL (e.g., for OpenRouter)
AI_BASE_URL=

# AI Model
AI_MODEL=gpt-4o-mini

# Database path
DATABASE_PATH=bot_database.db

# Proxy URL (optional)
PROXY_URL=

# === NEW v2 Settings ===

# Daily message limit per user (admins unlimited)
DAILY_MESSAGE_LIMIT=50

# Set true for server with SSL, false for local dev
USE_WEBHOOK=false

# Public URL (required for webhook)
WEBHOOK_URL=

# Webhook port
WEBHOOK_PORT=8443

# Optional secret token for webhook security
WEBHOOK_SECRET=

# === Phase 3 Settings ===

# Health check server port (separate from webhook port)
HEALTH_PORT=8080

# Use structured JSON logging (true for production, false for dev)
STRUCTURED_LOGGING=false

# AI client configuration
AI_TIMEOUT=30.0
AI_MAX_RETRIES=2

# === Cache Settings ===

# Cache database path
CACHE_DB_PATH=cache_database.db

# Cache TTL (Time-To-Live) in seconds
# AI responses cache for 1 hour
CACHE_TTL_AI=3600

# Web search results cache for 15 minutes (content changes faster)
CACHE_TTL_SEARCH=900

# Maximum cache entries (LRU eviction after this)
CACHE_MAX_ENTRIES=1000

# نکته: پنل ادمین از طریق دستور تلگرامی /admin در دسترسه (نه یک وب‌پنل جدا)،
# پس نیازی به متغیرهای ADMIN_PANEL_* نیست.
