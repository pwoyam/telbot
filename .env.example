# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated)
ADMIN_USER_IDS=123456789

# AI Provider: openai or anthropic
AI_PROVIDER=openai

# AI API Key
AI_API_KEY=your_api_key_here

# Optional: Custom base URL for OpenAI-compatible providers (e.g., OpenRouter)
AI_BASE_URL=

# AI Model (e.g., gpt-4o-mini, claude-3-haiku-20240307)
AI_MODEL=gpt-4o-mini

# Database path
DATABASE_PATH=bot_database.db

# Proxy URL (optional, for connecting to Telegram from restricted regions)
PROXY_URL=

# === NEW v2 Settings ===

# Daily message limit per user (admins are unlimited)
DAILY_MESSAGE_LIMIT=50

# Set to true for server deployment with SSL, false for local development
USE_WEBHOOK=false

# Public URL where your bot is accessible (required for webhook)
# Example: https://yourdomain.com or https://your-ip.com
WEBHOOK_URL=

# Port for webhook server (default: 8443)
WEBHOOK_PORT=8443

# Optional secret token for webhook verification (recommended for security)
WEBHOOK_SECRET=
